{
  "expo": {
    "name": "Barbería Yasser",
    "slug": "barberia-yasser",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "barberia-yasser",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d0d0d"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.barberiayasser.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#101b25"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "name": "Barbería Yasser",
      "shortName": "Barbería Yasser",
      "lang": "es",
      "themeColor": "#101b25",
      "backgroundColor": "#101b25",
      "output": "static"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que Barbería Yasser use la cámara para escanear códigos de barras.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
